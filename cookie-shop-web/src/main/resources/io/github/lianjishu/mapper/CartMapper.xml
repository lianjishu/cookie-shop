<?xml version="1.0" encoding="utf-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.github.lianjishu.mapper.CartMapper">

    <!-- 购物车结果映射：association 关联商品（教材第4章一对一关联） -->
    <resultMap id="cartMap" type="Cart">
        <id property="id" column="id"/>
        <result property="user_id" column="user_id"/>
        <result property="goods_id" column="goods_id"/>
        <result property="amount" column="amount"/>
        <association property="goods" javaType="Goods">
            <id property="id" column="g_id"/>
            <result property="name" column="g_name"/>
            <result property="cover" column="g_cover"/>
            <result property="price" column="g_price"/>
        </association>
    </resultMap>

    <insert id="addCart" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO cart(user_id, goods_id, amount) VALUES(#{user_id}, #{goods_id}, #{amount})
    </insert>

    <select id="selectByUserId" resultMap="cartMap">
        SELECT c.id, c.user_id, c.goods_id, c.amount,
               g.id AS g_id, g.name AS g_name, g.cover AS g_cover, g.price AS g_price
        FROM cart c LEFT JOIN goods g ON c.goods_id = g.id
        WHERE c.user_id = #{userId}
    </select>

    <select id="selectCountByUserId" resultType="int">
        SELECT COALESCE(SUM(amount), 0) FROM cart WHERE user_id = #{userId}
    </select>

    <select id="selectByUserIdAndGoodsId" resultType="Cart">
        SELECT id, user_id, goods_id, amount FROM cart WHERE user_id = #{userId} AND goods_id = #{goodsId}
    </select>

    <update id="updateAmount">
        UPDATE cart SET amount = #{amount} WHERE id = #{id}
    </update>

    <delete id="delete">
        DELETE FROM cart WHERE id = #{id}
    </delete>

    <delete id="clearByUserId">
        DELETE FROM cart WHERE user_id = #{userId}
    </delete>
</mapper>
